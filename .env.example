# Copy to .env (or set in your host's dashboard). Never commit real values.
# Required in production --------------------------------------------------
NODE_ENV=production
# Public https URL of this deployment. The MCP endpoint is $APP_URL/mcp and is also the OAuth issuer.
APP_URL=https://vendorflow.example.com
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Optional ------------------------------------------------------------------
PORT=3000
# Where the SQLite database and uploaded documents live. Must be a persistent disk/volume.
DATA_DIR=/data
# DATABASE_PATH=/data/vendorflow.db
# Seed the fictional demo organisation on first boot and show demo credentials on the login page.
DEMO_MODE=true
SEED_ON_EMPTY=true
DEMO_PASSWORD=VendorFlow-Demo-2026
MAX_UPLOAD_MB=10
# Scheduler interval for expiry/overdue checks (ms). Default: hourly.
JOB_INTERVAL_MS=3600000

# There are deliberately NO AI keys here. VendorFlow never calls an AI model.
